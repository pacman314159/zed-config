[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-=": "workspace::NewTerminal",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-right": "vim::ResizePaneRight",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-\\": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "escape": "editor::Cancel",
      "ctrl-\\": "workspace::ToggleBottomDock",
      "shift-j": ["workspace::SendKeystrokes", "1 3 j"],
      "shift-k": ["workspace::SendKeystrokes", "1 3 k"],
      "q": "editor::ScrollCursorCenter",
      "t": "editor::ToggleFold",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-right": "vim::ResizePaneRight",
      "ctrl-alt-j": "editor::MoveLineDown",
      "ctrl-alt-k": "editor::MoveLineUp",
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space x": ["workspace::SendKeystrokes", "ctrl-s ctrl-w"],
      "space shift-q": "workspace::CloseAllItemsAndPanes",
      "space t n": "workspace::NewFile",
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f g": "text_finder::Toggle",
      "space f s": "project_symbols::Toggle",
      "space f o": "projects::OpenRecent",
      "space f c": "command_palette::Toggle",
      "space c s": "theme_selector::Toggle",
      "space v c": "zed::OpenSettings",
      "space e": "project_panel::ToggleFocus",
      "space o": "outline_panel::ToggleFocus",
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g h": "editor::Hover",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "space c a": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",
      "space f m": "editor::Format",
      "space /": "editor::ToggleComments",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore",
      "alt-backspace": "editor::DeleteToPreviousWordStart",
      "ctrl-alt-j": "editor::MoveLineDown",
      "ctrl-alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-j": ["workspace::SendKeystrokes", "1 3 j"],
      "shift-k": ["workspace::SendKeystrokes", "1 3 k"],
      "space /": "editor::ToggleComments",
      "ctrl-alt-j": "editor::MoveLineDown",
      "ctrl-alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "j": "vim::MenuSelectNext",
      "k": "vim::MenuSelectPrevious",
      "down": "vim::MenuSelectNext",
      "up": "vim::MenuSelectPrevious",
      "h": "project_panel::CollapseSelectedEntry",
      "l": "project_panel::ExpandSelectedEntry",
      "enter": "project_panel::OpenPermanent",
      "ctrl-t": "project_panel::OpenPermanent",
      "ctrl-v": "project_panel::OpenSplitVertical",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "delete": "project_panel::Delete",
      "r": "project_panel::Rename",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "escape": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-\\": "workspace::ToggleBottomDock",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-]": "pane::ActivateNextItem",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-=": "workspace::NewTerminal",
      "ctrl--": "pane::CloseActiveItem",
      "ctrl-9": "pane::SplitLeft",
      "ctrl-0": "pane::SplitRight",
      "ctrl-'": "workspace::MoveFocusedPanelToNextPosition"
    },
  },
  {
    "context": "OutlinePanel",
    "bindings": {
      "space o": "outline_panel::ToggleFocus",
      "escape": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "FileFinder",
    "bindings": {
      "ctrl-t": "menu::Confirm"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "s": ["vim::PushSneakBackward", {}]
    }
  }
]
